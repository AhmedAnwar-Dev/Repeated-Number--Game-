using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace Repeated_Number
{
    internal class clsRepteadNumber
    {
        // ده الرقم المستهدف
        public byte targetNumber { get; private set; } = 0;
        
        // عدد الRound ال User اختارها
        public byte totalRounds { get; private set; }

        // الTimer بيبدء من كام
        public byte timerCountdown = 10;

        // الRound الحالي
        public byte currentRound { get; private set; } = 1;

        // عدد الرقم المستهدف متكرر كام مرة
        public byte targetNumberCount { get; private set; } = 0;
        
        // لعد الاجابات الصحيحة ال ادخلها الUser
        public byte correctAnswersCount { get; private set; } = 0;

        // لعد الاجابات الخاطئة الخاصة بالUser
        public byte wrongAnswersCount { get; private set; } = 0;

        // هنعرف الUser خلص ال ولا لا
        public bool IsGameOver => currentRound > totalRounds;

        // بنعد الرقم الtarget علشان نعرف نعمل بيه مقارنات
        private byte _CounterNumberTarget(List<byte> Nums)
        {
            byte Counter = 0;
            foreach (byte Num in Nums)
            {
                if (Num == targetNumber)
                    Counter++;
            }
            return Counter;
        }

        public clsRepteadNumber(byte TotalRound) => totalRounds = TotalRound;

        public void SetupNewRound(List<byte> ButtonNumber)
        {
            var random = new Random();
            
            // بنشوف الTarget Number من عشوائياً من بين ارقام الButton
            targetNumber = ButtonNumber[random.Next(0, ButtonNumber.Count)];

            // بنعد الرقم المستهدف متكرر كام مرة
            targetNumberCount = _CounterNumberTarget(ButtonNumber);
        }
        public bool SubmitAnswer(byte userAnswer)
        {
            // بنشوف هل الTarget NumberCount مساوي للدخله الUser
            bool isCorrect = userAnswer == targetNumberCount;

            if (isCorrect)
            {
                correctAnswersCount++;
                timerCountdown = 10;
            } // بنبدء نزود الرقم لو الاجابة ونرجع العداد تاني علشان ينقل للRound ال بعده
            else
            {
                wrongAnswersCount++;
                timerCountdown = 10;
            }

            currentRound++; // كل مرة بنستدعي فيها الدالة بنبدء نعد Round جديدة
            return isCorrect;
        }

        // دي بتستدعا عند خروج الوقت 
        public void RegisterTimeOut()
        {
            timerCountdown = 10;
            wrongAnswersCount++;
            currentRound++;
        }
    }
}
